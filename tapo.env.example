# Tapo cloud account (used for local device authentication).
TAPO_EMAIL=you@example.com
TAPO_PASSWORD=

# Newer firmware: enable "Third-Party Compatibility" in the Tapo app
# (Me -> Tapo Lab -> Third-Party Compatibility). It issues a separate local
# username/password. Set these two if the cloud password alone is rejected;
# otherwise leave them blank.
TAPO_LOCAL_USERNAME=
TAPO_LOCAL_PASSWORD=

# Optional: page heading and browser tab title.
# DASHBOARD_TITLE=Acme Office Plugs

# Timezone that schedules run in (default UTC).
# TZ=Europe/London
